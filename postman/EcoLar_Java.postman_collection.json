            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/residencias",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nmResidencia\": \"Casa criada pelo Postman\",\n  \"qtMoradores\": 2,\n  \"vlTarifaKwh\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"residenciaId\", pm.response.json().cdResidencia);"
            ]
