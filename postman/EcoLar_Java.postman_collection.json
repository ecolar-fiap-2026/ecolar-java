{
  "info": {
    "name": "EcoLar Java - CRUD Oracle (cria e remove apenas dados de teste)",
    "description": "Rodar na ordem. Requer Oracle configurado. Nao usa IDs dos 60 registros originais. IA possui exemplos no arquivo exemplos.http.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "residenciaId",
      "value": ""
    },
    {
      "key": "consumoId",
      "value": ""
    },
    {
      "key": "metaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Conexao com banco",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
